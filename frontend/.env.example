# Frontend-Umgebung (Vite). Kopieren nach `.env`.
# Nur mit Prefix VITE_ deklarierte Variablen sind im Client sichtbar.

# WebSocket-URL des Backends. Leer lassen für Kiosk/Prod (gleicher Origin via Nginx).
VITE_WS_URL=ws://localhost:8000/ws

# Wakeword (Picovoice Porcupine). Kostenlosen AccessKey auf console.picovoice.ai
# erstellen. Leer = Wakeword aus (Push-to-talk funktioniert weiterhin).
VITE_PICOVOICE_ACCESS_KEY=
