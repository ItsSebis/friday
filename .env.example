# ──────────────────────────────────────────────────────────────────────────
# Friday – Beispiel-Umgebungskonfiguration
# Kopieren nach `.env` und Werte eintragen. NIEMALS `.env` committen.
# ──────────────────────────────────────────────────────────────────────────

# ---- Backend / FastAPI ----
FRIDAY_HOST=0.0.0.0
FRIDAY_PORT=8000
FRIDAY_LOG_LEVEL=info
FRIDAY_ENV=development          # development | production

# Erlaubte CORS-/WebSocket-Origins (kommagetrennt)
FRIDAY_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- OpenRouter (LLM via Hermes) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-4-8
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Telegram (Hermes Tool) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# ---- Frontend (Vite, Prefix VITE_ ist Pflicht) ----
VITE_WS_URL=ws://localhost:8000/ws
