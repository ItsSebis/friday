# ──────────────────────────────────────────────────────────────────────────
# Friday – Beispiel-Umgebungskonfiguration
# Kopieren nach `.env` und Werte eintragen. NIEMALS `.env` committen.
# ──────────────────────────────────────────────────────────────────────────

# ---- Backend / FastAPI ----
FRIDAY_HOST=0.0.0.0
FRIDAY_PORT=8000
FRIDAY_LOG_LEVEL=info
FRIDAY_ENV=development          # development | production

# Erlaubte CORS-/WebSocket-Origins (kommagetrennt)
FRIDAY_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

# ---- Hermes Agent (OpenAI-kompatibler API-Server) ----
# Hermes verwaltet die LLM-Anbindung (OpenRouter) selbst — siehe ~/.hermes/config.yaml.
# Im Docker-Setup zeigt host.docker.internal auf den Host, auf dem Hermes läuft.
HERMES_BASE_URL=http://localhost:8642
HERMES_API_KEY=change-me-local-dev
HERMES_MODEL=hermes-agent

# ---- STT (Spracherkennung) ----
# Provider: "cloud" (genau, empfohlen) oder "local" (whisper.cpp, privat).
STT_PROVIDER=cloud
STT_LANGUAGE=de
# Cloud (OpenAI-kompatibel). Groq = kostenlos (2000 Anfragen/Tag) + sehr akkurat.
# Key auf console.groq.com erstellen. Für OpenAI: STT_API_BASE=https://api.openai.com/v1
STT_API_BASE=https://api.groq.com/openai/v1
STT_API_KEY=
STT_CLOUD_MODEL=whisper-large-v3-turbo
# Lokaler Fallback (nur bei STT_PROVIDER=local). Pfade relativ zum Backend-CWD.
STT_BINARY=whisper-cli
STT_MODEL=../docker/models/ggml-base.bin

# ---- TTS (Sprachausgabe) ----
# Provider: "elevenlabs" (natürlich, feminin) oder "piper" (lokal).
TTS_ENABLED=true
TTS_PROVIDER=elevenlabs
# ElevenLabs (elevenlabs.io). Voice-ID aus deinem Account; Default = "Rachel" (feminin).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
# Lokaler Fallback (nur bei TTS_PROVIDER=piper): pip install piper-tts
TTS_BINARY=piper
TTS_VOICE=../docker/models/de_DE-kerstin-low.onnx

# ---- Widgets: Wetter (Open-Meteo, KEIN Key nötig) ----
WEATHER_LAT=52.52
WEATHER_LON=13.405
WEATHER_TIMEZONE=auto

# ---- Widgets: Spotify (optional, Now Playing) ----
# OAuth-App auf https://developer.spotify.com anlegen, Refresh-Token einmalig
# mit Scope user-read-currently-playing erzeugen (siehe README).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# ---- Docker: Adresse von Hermes aus Sicht des Backend-Containers ----
# HERMES_BASE_URL=http://host.docker.internal:8642

# ---- Frontend (Vite, Prefix VITE_ ist Pflicht) ----
# Leer lassen für Kiosk/Prod (nutzt denselben Origin via Nginx-Proxy).
VITE_WS_URL=ws://localhost:8000/ws
